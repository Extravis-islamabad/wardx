# Copy to .env next to docker-compose.yml and fill in every blank value.
# Never commit the filled-in .env.

# ── Database ──
POSTGRES_USER=wardx
POSTGRES_DB=wardx
# openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Required secrets (production refuses to start without them) ──
# At least 32 characters: openssl rand -base64 48
WARDX_JWT_SECRET=
# Vault key-encryption key, base64 of 32 bytes: openssl rand -base64 32
# BACK THIS UP OFFLINE. Losing it makes every vaulted secret unrecoverable.
WARDX_VAULT_KEK=
WARDX_VAULT_KEK_RETIRED=

# First admin, created only while the user table is empty.
WARDX_BOOTSTRAP_ADMIN_USERNAME=admin
WARDX_BOOTSTRAP_ADMIN_PASSWORD=

# ── Network ──
# Host ports
WARDX_WEB_PORT=8080
WARDX_GATEWAY_PORT=2222
# Name users type in "ssh -p 2222 you%account%target@<this>"
WARDX_GATEWAY_PUBLIC_HOST=localhost
# The console is served same-origin through nginx; list extra origins only if needed.
WARDX_CORS_ORIGINS=["http://localhost:8080"]
# Trust X-Forwarded-For from the web container's Docker network.
WARDX_TRUSTED_PROXIES=["172.16.0.0/12","10.0.0.0/8","192.168.0.0/16"]

# ── Optional ──
WARDX_MFA_REQUIRED_ROLES=["admin"]
# Gateway host key: generated once on the data volume if unset.
# WARDX_GATEWAY_HOST_KEY_FILE=/data/keys/gateway_host_key
