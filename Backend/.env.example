# Copy to .env. Every setting is prefixed WARDX_.
WARDX_ENVIRONMENT=development
# api = API + scheduler, api_only = API only, scheduler = workers only
WARDX_APP_ROLE=api
WARDX_DATABASE_URL=postgresql+asyncpg://wardx:wardx@localhost:5432/wardx

# Required in production. In development a random secret is generated into .wardx/ on first start.
WARDX_JWT_SECRET=
# Vault key-encryption key: base64 of 32 random bytes (openssl rand -base64 32).
# Required in production; development generates .wardx/kek.key.
WARDX_VAULT_KEK=
# Comma-separated retired KEKs, still accepted for decryption while secrets are re-wrapped.
WARDX_VAULT_KEK_RETIRED=

# First admin, created only when no users exist.
WARDX_BOOTSTRAP_ADMIN_USERNAME=admin
WARDX_BOOTSTRAP_ADMIN_PASSWORD=

WARDX_CORS_ORIGINS=["http://localhost:5173"]
